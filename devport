#!/usr/bin/env python3
import argparse
import fcntl
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import tempfile
from contextlib import contextmanager

ROOT = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'devport'
REGISTRY = ROOT / 'registry.json'
FIRST, LAST = 3000, 9999


def listeners():
    result = subprocess.run(['ss', '-H', '-ltnp'], capture_output=True, text=True, check=True)
    ports = {}
    import re
    for line in result.stdout.splitlines():
        fields = line.split(None, 5)
        if len(fields) < 5:
            continue
        try:
            port = int(fields[3].rsplit(':', 1)[1])
        except (ValueError, IndexError):
            continue
        pids = {int(p) for p in re.findall(r'pid=(\d+)', line)}
        ports.setdefault(port, set()).update(pids)
    return ports


def cwd(pid):
    try:
        return os.readlink(f'/proc/{pid}/cwd')
    except OSError:
        return '?'


def owned(pid, project):
    directory = cwd(pid)
    return directory == project or directory.startswith(project + '/')


def free(port):
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.bind(('0.0.0.0', port))
        if socket.has_ipv6:
            with socket.socket(socket.AF_INET6, socket.SOCK_STREAM) as sock:
                sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
                sock.bind(('::', port))
        return True
    except OSError:
        return False


@contextmanager
def registry():
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / 'registry.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = json.loads(REGISTRY.read_text()) if REGISTRY.exists() else {}
        yield data


def save(data):
    with tempfile.NamedTemporaryFile('w', dir=ROOT, delete=False) as file:
        name = file.name
        json.dump(data, file, indent=2)
        file.write('\n')
    os.replace(name, REGISTRY)


def table(headers, rows):
    rows = [headers] + [[str(v) for v in row] for row in rows]
    widths = [max(len(row[i]) for row in rows) for i in range(len(headers))]
    for i, row in enumerate(rows):
        print('  '.join(v.ljust(w) for v, w in zip(row, widths)).rstrip())
        if i == 0:
            print('  '.join('-' * w for w in widths))


def target(data, port, project):
    if port is not None:
        return port, next((p for p, n in data.items() if n == port), None)
    if project not in data:
        raise ValueError('Current directory is not registered.')
    return data[project], project


def main():
    parser = argparse.ArgumentParser(prog='devport')
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('list')
    sub.add_parser('scan')
    run = sub.add_parser('run')
    run.add_argument('command', nargs=argparse.REMAINDER)
    set_port = sub.add_parser('set', help='Set the current project’s reserved port')
    set_port.add_argument('port', type=int)
    for action in ('kill', 'remove'):
        p = sub.add_parser(action)
        p.add_argument('port', nargs='?', type=int)
        if action == 'kill':
            p.add_argument('--force', action='store_true', help='Allow stopping unrelated or unregistered listeners')
    args = parser.parse_args()
    project = str(Path.cwd().resolve())
    with registry() as data:
        active = listeners()
        if args.action == 'list':
            rows = []
            for path, port in sorted(data.items(), key=lambda x: x[1]):
                pids = active.get(port, set())
                status = ('Running' if pids and all(owned(pid, path) for pid in pids) else 'Occupied') if port in active else 'Stopped'
                rows.append((Path(path).name, port, status, path))
            table(['PROJECT', 'PORT', 'STATUS', 'PATH'], rows)
        elif args.action == 'scan':
            table(['PORT', 'PID', 'DIRECTORY'], [(port, pid or '?', cwd(pid) if pid else '?') for port, pids in sorted(active.items()) for pid in sorted(pids) or [None]])
        elif args.action == 'set':
            port = args.port
            if not 1 <= port <= 65535:
                raise ValueError('Port must be between 1 and 65535.')
            previous = data.get(project)
            if previous == port:
                print(f'Port {port} is already assigned to {project}.')
                return 0
            if previous is not None and previous in active:
                raise ValueError(f'Current port {previous} is occupied; stop its server before changing.')
            other = next((path for path, number in data.items() if number == port and path != project), None)
            if other is not None:
                raise ValueError(f'Port {port} is reserved for {other}.')
            if port in active or not free(port):
                raise ValueError(f'Port {port} is occupied or unavailable.')
            data[project] = port
            save(data)
            print(f'{project}: {previous} -> {port}' if previous is not None else f'{project}: assigned port {port}')
        elif args.action == 'run':
            command = args.command
            if command and command[0] == '--':
                command = command[1:]
            if not command:
                raise ValueError('Usage: devport run <command> [args...]')
            port = data.get(project)
            if port is None:
                reserved = set(data.values())
                port = next((n for n in range(FIRST, LAST + 1) if n not in reserved and n not in active and free(n)), None)
                if port is None:
                    raise ValueError('No available port in allocation range.')
                data[project] = port
                save(data)
            elif port in active or not free(port):
                raise ValueError(f'Allocated port {port} is occupied; allocation unchanged.')
            print(f'devport: {project} -> PORT={port}', flush=True)
        else:
            port, path = target(data, args.port, project)
            if args.action == 'remove':
                if path is None:
                    raise ValueError(f'Port {port} is not registered.')
                if port in active:
                    raise ValueError(f'Port {port} is occupied; stop its server before removing.')
                del data[path]
                save(data)
                print(f'Released port {port}: {path}')
            else:
                if port not in active:
                    print(f'No TCP listener on port {port}.')
                    return 0
                pids = active[port]
                if not pids:
                    raise ValueError('Listener PID unavailable; check process permissions.')
                if not args.force and (path is None or not all(owned(pid, path) for pid in pids)):
                    raise ValueError('Listener is not confirmed to belong to the registered project; use --force to proceed.')
                for pid in sorted(pids):
                    try:
                        os.kill(pid, signal.SIGTERM)
                        print(f'Sent SIGTERM to PID {pid} on port {port}.')
                    except ProcessLookupError:
                        pass
    if args.action == 'run':
        os.execvpe(command[0], command, {**os.environ, 'PORT': str(port)})
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f'devport: {exc}', file=sys.stderr)
        sys.exit(1)
